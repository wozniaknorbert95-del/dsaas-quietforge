@prefix qf: <https://quietforge.flexgrafik.nl/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# =============================================================================
# C1 LEAK PATCHERS — The 5 Verified FlexGrafik Systems (PROVEN)
# =============================================================================
# Status: Awaiting DSaaS Integration. Manual Commander Override Active.
# Each patcher is an instance of qf:Patcher with verified tech stack and time equations.
# Proof tier: PROVEN (traceable live systems, artefacts, walkthroughs)
# =============================================================================

qf:Patcher a rdfs:Class ;
    rdfs:label "Leak Patcher"@en ;
    rdfs:comment "A verified, production-grade system that eliminates a specific operational leak for Dutch SMBs."@en .

qf:hasTurtleId a rdf:Property ;
    rdfs:domain qf:Patcher ;
    rdfs:range xsd:string ;
    rdfs:label "Internal Turtle identifier"@en .

qf:hasSystemName a rdf:Property ;
    rdfs:domain qf:Patcher ;
    rdfs:range xsd:string ;
    rdfs:label "Human-readable system name"@en .

qf:hasRepoKey a rdf:Property ;
    rdfs:domain qf:Patcher ;
    rdfs:range xsd:string ;
    rdfs:label "FlexGrafik repository key"@en .

qf:hasStatus a rdf:Property ;
    rdfs:domain qf:Patcher ;
    rdfs:range xsd:string ;
    rdfs:label "Proof tier: PROVEN, DEMO, or PLANNED"@en .

qf:hasTechStack a rdf:Property ;
    rdfs:domain qf:Patcher ;
    rdfs:range xsd:string ;
    rdfs:label "Verified technology stack"@en .

qf:hasTimeEquationBefore a rdf:Property ;
    rdfs:domain qf:Patcher ;
    rdfs:range xsd:string ;
    rdfs:label "Manual process duration before patcher"@en .

qf:hasTimeEquationAfter a rdf:Property ;
    rdfs:domain qf:Patcher ;
    rdfs:range xsd:string ;
    rdfs:label "Automated process duration after patcher"@en .

qf:hasTimeSavingHours a rdf:Property ;
    rdfs:domain qf:Patcher ;
    rdfs:range xsd:decimal ;
    rdfs:label "Hours saved per typical engagement"@en .

qf:hasBusinessEffect a rdf:Property ;
    rdfs:domain qf:Patcher ;
    rdfs:range xsd:string ;
    rdfs:label "Measurable business effect"@en .

qf:hasProofUrl a rdf:Property ;
    rdfs:domain qf:Patcher ;
    rdfs:range xsd:anyURI ;
    rdfs:label "Live proof artefact URL"@en .

qf:hasIntent a rdf:Property ;
    rdfs:domain qf:Patcher ;
    rdfs:range xsd:string ;
    rdfs:label "Primary intent: time, money, order, calm, efficiency"@en .

# =============================================================================
# PATCHER 1: Wizard Cash Engine & Checkout Flow
# =============================================================================
qf:patcher-wizard a qf:Patcher ;
    qf:hasTurtleId "qf:patcher-wizard" ;
    qf:hasSystemName "Wizard Cash Engine & Checkout Flow" ;
    qf:hasRepoKey "zzpackage" ;
    qf:hasStatus "PROVEN" ;
    qf:hasTechStack "Node.js (Next.js 16), TypeScript, Tailwind v4, Framer Motion, Mollie Payments, OPA (policy gates), SPARQL (product master)" ;
    qf:hasTimeEquationBefore "3-day email ping-pong: client asks → you clarify → you calculate → you send offerte → client negotiates → you adjust → client accepts → you send payment link" ;
    qf:hasTimeEquationAfter "90-second guided flow: client configures → sees live price → pays via Mollie → order confirmed" ;
    qf:hasTimeEquationBeforeHours "24.0"^^xsd:decimal ;
    qf:hasTimeEquationAfterHours "0.025"^^xsd:decimal ;
    qf:hasTimeSavingHours "23.975"^^xsd:decimal ;
    qf:hasBusinessEffect "Eliminates quote ghosting, captures deposit upfront, reduces sales cycle from days to minutes, qualifies budget before human touch" ;
    qf:hasProofUrl <https://zzpackage.flexgrafik.nl/voertuigreclame-ontwerp/> ;
    qf:hasIntent "money" ;
    qf:hasIntent "efficiency" ;
    dct:created "2026-06-15"^^xsd:date ;
    dct:modified "2026-08-02"^^xsd:date ;
    prov:wasGeneratedBy <https://github.com/wozniaknorbert95-del/zzpackage> ;
    rdfs:comment "Spearhead module. 9 UI screens, 7 business decision stages. 167 active SKUs in product master. Live checkout with Mollie."@en .

# =============================================================================
# PATCHER 2: Trust Portal & Supervised AI Chat
# =============================================================================
qf:patcher-portal a qf:Patcher ;
    qf:hasTurtleId "qf:patcher-portal" ;
    qf:hasSystemName "Trust Portal & Supervised AI Chat" ;
    qf:hasRepoKey "flexgrafik-nl" ;
    qf:hasStatus "PROVEN" ;
    qf:hasTechStack "Node.js (Next.js 16), React 19, TypeScript, Tailwind v4, Supervised AI Chat (customer_agent), OPA qualification gates" ;
    qf:hasTimeEquationBefore "Brochure website: visitors browse → leave → zero capture → you wonder why enquiries are flat" ;
    qf:hasTimeEquationAfter "Trust path: visitor lands → sees proof → supervised chat qualifies → handoff to Wizard or booked call" ;
    qf:hasTimeEquationBeforeHours "0"^^xsd:decimal ;
    qf:hasTimeEquationAfterHours "0.5"^^xsd:decimal ;
    qf:hasTimeSavingHours "12.0"^^xsd:decimal ;
    qf:hasBusinessEffect "Converts anonymous traffic into qualified handoffs. Generic sales chat LIVE. Qualification API proven. Portal UX rollout PARTIAL." ;
    qf:hasProofUrl <https://flexgrafik.nl/> ;
    qf:hasIntent "money" ;
    qf:hasIntent "order" ;
    dct:created "2026-05-20"^^xsd:date ;
    dct:modified "2026-07-19"^^xsd:date ;
    prov:wasGeneratedBy <https://github.com/wozniaknorbert95-del/flexgrafik-nl> ;
    rdfs:comment "Qualification API LIVE. Portal UX remains generic (INT-012). Supervised chat prevents hallucination in client-facing context."@en .

# =============================================================================
# PATCHER 3: Lead Magnet Game (Bouwplaats Chaos)
# =============================================================================
qf:patcher-game a qf:Patcher ;
    qf:hasTurtleId "qf:patcher-game" ;
    qf:hasSystemName "Lead Magnet Game (Bouwplaats Chaos)" ;
    qf:hasRepoKey "app.flexgrafik.nl" ;
    qf:hasStatus "PROVEN" ;
    qf:hasTechStack "Node.js (Next.js 16), React 19, TypeScript, Canvas/PWA, Tailwind v4, Leaderboard engine, Wizard bridge with tier-aware codes" ;
    qf:hasTimeEquationBefore "Paid ads → cold landing page → 2% convert → 98% waste → you chase unqualified leads" ;
    qf:hasTimeEquationAfter "Play → reward (discount code) → Wizard handoff with tier-aware code → only qualified buyers reach you" ;
    qf:hasTimeEquationBeforeHours "8.0"^^xsd:decimal ;
    qf:hasTimeEquationAfterHours "0.25"^^xsd:decimal ;
    qf:hasTimeSavingHours "7.75"^^xsd:decimal ;
    qf:hasBusinessEffect "Selective acquisition: 5 levels (Beginner → Boss: Belastingdienst), 4-tier reward ladder, monthly seasons. Game-sourced visitors enter same configurator paying clients use." ;
    qf:hasProofUrl <https://app.flexgrafik.nl/> ;
    qf:hasIntent "money" ;
    dct:created "2026-04-10"^^xsd:date ;
    dct:modified "2026-07-19"^^xsd:date ;
    prov:wasGeneratedBy <https://github.com/wozniaknorbert95-del/app.flexgrafik.nl> ;
    rdfs:comment "PWA, rewards, Wizard bridge, lead sync INT-004 LIVE. Selective fit — not default after every Web Upgrade."@en .

# =============================================================================
