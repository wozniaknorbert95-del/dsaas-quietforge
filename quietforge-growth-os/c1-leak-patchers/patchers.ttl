    qf:hasTechStack "Node.js, Python (FastAPI), OPA (Rego), SPARQL, LangGraph, TypeScript, GitHub Actions CI/CD, EU VPS hosting" ;
    qf:hasTimeEquationBefore "Ad-hoc changes: no logged gate → silent drift → production breaks → firefighting weekends" ;
    qf:hasTimeEquationAfter "Fixed supervised workflow: 8-repo scan → conflict detection → KODA assistant → HITL approve → deploy with audit trail" ;
    qf:hasTimeEquationBeforeHours "6.0"^^xsd:decimal ;
    qf:hasTimeEquationAfterHours "0.5"^^xsd:decimal ;
    qf:hasTimeSavingHours "5.5"^^xsd:decimal ;
    qf:hasBusinessEffect "Governance: 8-repo scan, Conflicts: 0 target. Operations: Commander cockpit, Marketing Brain shadow F0-F3, weekly HITL brief. Engineering: 5-node LangGraph, hybrid VPS+local, prod E2E handoff." ;
    qf:hasProofUrl <https://os.flexgrafik.nl/> ;
    qf:hasIntent "time" ;
    qf:hasIntent "calm" ;
    qf:hasIntent "order" ;
    qf:hasIntent "efficiency" ;
    dct:created "2026-03-15"^^xsd:date ;
    dct:modified "2026-08-02"^^xsd:date ;
    prov:wasGeneratedBy <https://github.com/wozniaknorbert95-del/flex-vcms> ;
    prov:wasGeneratedBy <https://github.com/wozniaknorbert95-del/agent-os> ;
    prov:wasGeneratedBy <https://github.com/wozniaknorbert95-del/agent-os-ui> ;
    rdfs:comment "Three-brain architecture: VCMS (Governance), Jadzia COI (Operations), Agent OS (Engineering). HITL always. Zasada 11: Deploy manual only."@en .

# =============================================================================
# INTENT MAPPING FOR QUERYING
# =============================================================================
qf:intent-time a qf:Intent ;
    rdfs:label "Save time"@en ;
    rdfs:label "Tijd besparen"@nl .

qf:intent-money a qf:Intent ;
    rdfs:label "Earn more"@en ;
    rdfs:label "Meer verdienen"@nl .

qf:intent-order a qf:Intent ;
    rdfs:label "Order systems and tech"@en ;
    rdfs:label "Systemen en tech ordenen"@nl .

qf:intent-calm a qf:Intent ;
    rdfs:label "Less chaos and stress"@en ;
    rdfs:label "Minder chaos en stress"@nl .

qf:intent-efficiency a qf:Intent ;
    rdfs:label "Raise team efficiency"@en ;
    rdfs:label "Teamefficiëntie verhogen"@nl .

# Link patchers to intents
qf:patcher-wizard qf:hasIntent qf:intent-money, qf:intent-efficiency .
qf:patcher-portal qf:hasIntent qf:intent-money, qf:intent-order .
qf:patcher-game qf:hasIntent qf:intent-money .
qf:patcher-inspire qf:hasIntent qf:intent-money, qf:intent-order, qf:intent-calm .
qf:patcher-dsaas qf:hasIntent qf:intent-time, qf:intent-calm, qf:intent-order, qf:intent-efficiency .