# =============================================================================
qf:patcher-dsaas a qf:Patcher ;
    qf:hasTurtleId "qf:patcher-dsaas" ;
    qf:hasSystemName "Quietforge DSaaS Platform (VCMS + Mission Control + Agent OS)" ;
    qf:hasRepoKey "flex-vcms" ;
    qf:hasComponentRepos "flex-vcms, agent-os, agent-os-ui" ;
