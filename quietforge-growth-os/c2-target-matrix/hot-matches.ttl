@prefix qf: <https://quietforge.flexgrafik.nl/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .

# =============================================================================
# C2 HOT MATCHES — Target ↔ Patcher Priority Scoring
# =============================================================================
# Each qf:Match represents a Target-Patcher pairing with calculated priority
# Score formula: (PainLevel * 0.4) + (DecisionSpeedWeight * 0.3) + (TimeSavingPotential * 0.3)
# DecisionSpeedWeight: fast=100, medium=70, slow=40
# TimeSavingPotential: based on patcher's hasTimeSavingHours * leak frequency
# =============================================================================

qf:Match a rdfs:Class ;
    rdfs:label "Hot Match"@en ;
    rdfs:comment "A Target-Patcher pairing with calculated priority score and recommended channel."@en .

qf:hasMatchId a rdf:Property ;
    rdfs:domain qf:Match ;
    rdfs:range xsd:string .

qf:hasTarget a rdf:Property ;
    rdfs:domain qf:Match ;
    rdfs:range qf:Target .

qf:hasPatcher a rdf:Property ;
    rdfs:domain qf:Match ;
    rdfs:range qf:Patcher .

qf:hasPriorityScore a rdf:Property ;
    rdfs:domain qf:Match ;
    rdfs:range xsd:integer ;
    rdfs:label "Priority Score 1-100"@en .

qf:hasPainLevelWeight a rdf:Property ;
    rdfs:domain qf:Match ;
    rdfs:range xsd:decimal .

qf:hasDecisionSpeedWeight a rdf:Property ;
    rdfs:domain qf:Match ;
    rdfs:range xsd:decimal .

qf:hasTimeSavingWeight a rdf:Property ;
    rdfs:domain qf:Match ;
    rdfs:range xsd:decimal .

qf:hasRecommendedChannel a rdf:Property ;
    rdfs:domain qf:Match ;
    rdfs:range xsd:string ;
    rdfs:label "Primary channel: LinkedIn, Facebook, Shorts"@en .

qf:hasRecommendedPostId a rdf:Property ;
    rdfs:domain qf:Match ;
    rdfs:range xsd:string ;
    rdfs:label "Reference to content-engine/proposals/ post"@en .

qf:hasTimeSavingPerEngagement a rdf:Property ;
    rdfs:domain qf:Match ;
    rdfs:range xsd:decimal ;
    rdfs:label "Hours saved per typical client engagement"@en .

qf:hasEstimatedDealValue a rdf:Property ;
    rdfs:domain qf:Match ;
    rdfs:range xsd:integer ;
    rdfs:label "Estimated deal value EUR (Automation Map + Build)"@en .

qf:hasUrgencySignal a rdf:Property ;
    rdfs:domain qf:Match ;
    rdfs:range xsd:string ;
    rdfs:label "Urgency signal for copy: immediate, this-week, this-month"@en .

# =============================================================================
# MATCH 1: Car Wrapping × Wizard Cash Engine
# =============================================================================
qf:match-carwrap-wizard a qf:Match ;
    qf:hasMatchId "qf:match-carwrap-wizard" ;
    qf:hasTarget qf:target-carwrapping ;
    qf:hasPatcher qf:patcher-wizard ;
    qf:hasPriorityScore "96"^^xsd:integer ;
    qf:hasPainLevelWeight "36.8"^^xsd:decimal ;
    qf:hasDecisionSpeedWeight "30.0"^^xsd:decimal ;
    qf:hasTimeSavingWeight "29.97"^^xsd:decimal ;
    qf:hasRecommendedChannel "LinkedIn" ;
    qf:hasRecommendedPostId "linkedin-01-wizard-quote-leak" ;
    qf:hasTimeSavingPerEngagement "23.975"^^xsd:decimal ;
    qf:hasEstimatedDealValue "290"^^xsd:integer ;
    qf:hasUrgencySignal "immediate" ;
    dct:created "2026-08-09"^^xsd:date ;
    rdfs:comment "Highest priority. Zondag offertes = visceral pain. 72h → 90s is undeniable. Car wrappers decide fast when they see the math."@en .

