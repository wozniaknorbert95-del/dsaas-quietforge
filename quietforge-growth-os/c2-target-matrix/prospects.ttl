@prefix qf: <https://quietforge.flexgrafik.nl/ontology/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

qf:Target a rdfs:Class ;
    rdfs:label "Niche Target ICP" ;
    rdfs:comment "A specific Dutch SMB/ZZP business niche targeting group." .

qf:CreativeAgencies a qf:Target ;
    rdfs:label "Dutch Creative Agencies" ;
    qf:hasNicheRegion "Netherlands (NL)" ;
    qf:typicalSize "ZZP / small BV (2-15 employees)" ;
    qf:hasLeak qf:ManualProposalDrafting ;
    qf:hasLeak qf:UnqualifiedDiscoveryCalls .

qf:CarWrappingShops a qf:Target ;
    rdfs:label "Premium Car Wrapping and Branding Shops" ;
    qf:hasNicheRegion "Netherlands (NL)" ;
    qf:typicalSize "ZZP / small BV (1-8 employees)" ;
    qf:hasLeak qf:ManualVehicleBrandingEstimates ;
    qf:hasLeak qf:UnstructuredAssetCollection .

qf:PremiumTradesmen a qf:Target ;
    rdfs:label "Premium Tradesmen (Aannemers & Builders)" ;
    qf:hasNicheRegion "Netherlands (NL)" ;
    qf:typicalSize "ZZP / small BV (1-12 employees)" ;
    qf:hasLeak qf:ManualOffertePreparation ;
    qf:hasLeak qf:LateInvoiceFollowups .

qf:ManualProposalDrafting a qf:Leak ;
    rdfs:label "Manual RFP and Proposal drafting" ;
    qf:wastedHoursPerWeek "12.0"^^xsd:decimal ;
    qf:leakDescription "Wasting hours drafting custom proposals for leads who might not even have a budget of €1,000+." .

qf:UnqualifiedDiscoveryCalls a qf:Leak ;
    rdfs:label "Unqualified free consulting calls" ;
    qf:wastedHoursPerWeek "8.0"^^xsd:decimal ;
    qf:leakDescription "Conducting multiple free 45-minute discovery calls each week with brochure-only clients." .

qf:ManualVehicleBrandingEstimates a qf:Leak ;
    rdfs:label "Manual vehicle-branding offer calculation" ;
    qf:wastedHoursPerWeek "10.0"^^xsd:decimal ;
    qf:leakDescription "Manually measuring vinyl square meters and calculating film costs for various vehicle templates." .

qf:UnstructuredAssetCollection a qf:Leak ;
    rdfs:label "Chasing clients for high-res logo vectors" ;
    qf:wastedHoursPerWeek "6.0"^^xsd:decimal ;
    qf:leakDescription "Endless email chains chasing clients for vector files or vehicle measurements." .

qf:ManualOffertePreparation a qf:Leak ;
    rdfs:label "Manual Offerte preparation and KVK verification" ;
    qf:wastedHoursPerWeek "15.0"^^xsd:decimal ;
    qf:leakDescription "Writing custom offer sheets in Word/Excel, double-checking KvK details manually, and waiting for signatures." .

qf:LateInvoiceFollowups a qf:Leak ;
    rdfs:label "Manual administratie and chasing late BTW-invoice payments" ;
    qf:wastedHoursPerWeek "5.0"^^xsd:decimal ;
    qf:leakDescription "Sending manual invoice reminders on Friday afternoons instead of being on the terrace." .
