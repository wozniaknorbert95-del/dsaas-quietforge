@prefix qf: <https://quietforge.flexgrafik.nl/ontology/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

qf:Patcher a rdfs:Class ;
    rdfs:label "System Leak Patcher" ;
    rdfs:comment "A system designed to patch operational or marketing time leaks." .

qf:WizardCashEngine a qf:Patcher ;
    rdfs:label "Wizard Cash Engine (zzpackage)" ;
    qf:techStack "Next.js 16, React 19, Tailwind v4, Mollie SDK, Calendly API" ;
    qf:beforeManualHours "10.0"^^xsd:decimal ;
    qf:afterAutomatedSeconds "10.0"^^xsd:decimal ;
    qf:timeSavingEquation "Before: 10 hours of manual back-and-forth email quoting vs After: 10 seconds structured intake with client-side Mollie pre-payment link." ;
    qf:hasReadinessStatus "LIVE" .

qf:InboxKiller a qf:Patcher ;
    rdfs:label "Inbox Killer" ;
    qf:techStack "Next.js App Router, OpenAI API, Tailwind v4, Vercel" ;
    qf:beforeManualHours "15.0"^^xsd:decimal ;
    qf:afterAutomatedSeconds "120.0"^^xsd:decimal ;
    qf:timeSavingEquation "Before: 15 hours of manual email triage and lead qualification vs After: 2 minutes automated classification, routing, and response staging." ;
    qf:hasReadinessStatus "LIVE" .

qf:JadziaCOI a qf:Patcher ;
    rdfs:label "Jadzia Back-office Orchestrator" ;
    qf:techStack "Next.js App Router, Jadzia Engine, Node.js, Webhooks" ;
    qf:beforeManualHours "20.0"^^xsd:decimal ;
    qf:afterAutomatedSeconds "30.0"^^xsd:decimal ;
    qf:timeSavingEquation "Before: 20 hours of manual copy-pasting customer records, generating invoices, and checking systems vs After: 30 seconds secure automated back-office workflow execution." ;
    qf:hasReadinessStatus "PARTIAL" .

qf:LeadMagnetGame a qf:Patcher ;
    rdfs:label "Lead Magnet Game Ladder" ;
    qf:techStack "React 19, Tailwind v4, GA4 Custom Events, Next.js" ;
    qf:beforeManualHours "8.0"^^xsd:decimal ;
    qf:afterAutomatedSeconds "15.0"^^xsd:decimal ;
    qf:timeSavingEquation "Before: 8 hours pitching cold leads and explaining basic services vs After: 15 seconds interactive gamified qualification with dynamic leaderboard and lead capture." ;
    qf:hasReadinessStatus "LIVE" .

qf:VcmsScan a qf:Patcher ;
    rdfs:label "VCMS Governance Scan" ;
    qf:techStack "Next.js App Router, Flex-vcms Assistant, Node.js" ;
    qf:beforeManualHours "5.0"^^xsd:decimal ;
    qf:afterAutomatedSeconds "5.0"^^xsd:decimal ;
    qf:timeSavingEquation "Before: 5 hours manual dependency checking, site audit, and conflict reporting vs After: 5 seconds automated integrity scan." ;
    qf:hasReadinessStatus "LIVE" .
